TZ={{ pgbouncer_environment_variables_tz }}

{% if pgbouncer_container_unix_socket_enabled %}
PGBOUNCER_UNIX_SOCKET_DIR={{ pgbouncer_run_path_in_container }}
{% endif %}

{% if pgbouncer_connection_hostname != '' %}
PGBOUNCER_LISTEN_ADDR={{ pgbouncer_connection_hostname }}
{% endif %}

PGBOUNCER_LISTEN_PORT={{ pgbouncer_connection_port }}

{% if pgbouncer_environment_variables_pgbouncer_pool_mode != '' %}
PGBOUNCER_POOL_MODE={{ pgbouncer_environment_variables_pgbouncer_pool_mode }}
{% endif %}

PGBOUNCER_CLIENT_TLS_SSLMODE={{ pgbouncer_environment_variables_pgbouncer_client_tls_sslmode }}

PGBOUNCER_SERVER_TLS_SSLMODE={{ pgbouncer_environment_variables_pgbouncer_server_tls_sslmode }}

DATABASES_HOST={{ pgbouncer_environment_variables_databases_host }}
DATABASES_PORT={{ pgbouncer_environment_variables_databases_port }}
DATABASES_USER={{ pgbouncer_environment_variables_databases_user }}
DATABASES_PASSWORD={{ pgbouncer_environment_variables_databases_password }}
DATABASES_DBNAME={{ pgbouncer_environment_variables_databases_dbname }}

{{ pgbouncer_environment_variables_additional_variables }}
