[Unit]
Description=PgBouncer ({{ pgbouncer_identifier }})
{% for service in pgbouncer_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in pgbouncer_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ pgbouncer_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ pgbouncer_identifier }} \
      --log-driver=none \
      --user={{ pgbouncer_uid }}:{{ pgbouncer_gid }} \
      --cap-drop=ALL \
      --read-only \
      {% if pgbouncer_container_network_host_enabled %}
      --net=host \
      {% else %}
      --network={{ pgbouncer_container_network }} \
      {% endif %}
      {% if pgbouncer_container_http_host_bind_port %}
      -p {{ pgbouncer_container_http_host_bind_port }}:{{ pgbouncer_container_http_port }} \
      {% endif %}
      --env-file={{ pgbouncer_base_path }}/env \
      {{ pgbouncer_container_image_self_build_name if pgbouncer_container_image_self_build else pgbouncer_container_image }} \
      {% for arg in pgbouncer_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% if pgbouncer_container_network_host_enabled %}
{% else %}
{% for network in pgbouncer_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ pgbouncer_identifier }}
{% endfor %}
{% endif %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ pgbouncer_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ pgbouncer_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ pgbouncer_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ pgbouncer_identifier }}

[Install]
WantedBy=multi-user.target
