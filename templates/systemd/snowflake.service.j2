[Unit]
Description=Snowflake proxy ({{ snowflake_identifier }})
{% for service in snowflake_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in snowflake_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ snowflake_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ snowflake_identifier }} \
      --log-driver=none \
      --user={{ snowflake_uid }}:{{ snowflake_gid }} \
      --cap-drop=ALL \
      --read-only \
      {% if snowflake_container_network_host_enabled %}
      --net=host \
      {% else %}
      --network={{ snowflake_container_network }} \
      {% endif %}
      --env-file={{ snowflake_base_path }}/env \
      {{ snowflake_container_image_self_build_name if snowflake_container_image_self_build else snowflake_container_image }} \
      {% for arg in snowflake_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% if snowflake_container_network_host_enabled %}
{% else %}
{% for network in snowflake_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ snowflake_identifier }}
{% endfor %}
{% endif %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ snowflake_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ snowflake_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ snowflake_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ snowflake_identifier }}

[Install]
WantedBy=multi-user.target
